{
  "name": "zhiti-local-question-bank",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-homework-assets.mjs && node scripts/sync-local-env.mjs && wrangler d1 migrations apply zhiti-question-bank --local && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 0.0.0.0 --port 3001",
    "build": "node scripts/prepare-homework-assets.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy": "node scripts/prepare-homework-assets.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext-cloudflare deploy",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node scripts/run-tests.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:audit:scoped": "node scripts/audit-scoped-library.mjs",
    "db:audit:scoped:remote": "node scripts/audit-scoped-library.mjs --remote",
    "taxonomy:validate": "node scripts/validate-china-taxonomy.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "test:studio": "node scripts/test-studio.mjs",
    "benchmark:studio": "node scripts/benchmark-studio.mjs"
  },
  "dependencies": {
    "@techstark/opencv-js": "5.0.0-release.1",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.11.0",
    "html2canvas": "^1.4.1",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
